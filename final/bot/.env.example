# Secrets
TELEGRAM_BOT_TOKEN=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Paths, relative to the bot directory unless absolute
DB_PATH=bot.db
MCP_CONFIG_PATH=mcp.json
# Interpreter for fs_worker and user venvs: must be readable by user-<id> accounts
SYSTEM_PYTHON=/usr/bin/python3

# Context
CONTEXT_LIMIT_TOKENS=64000
AGENTS_MD_MAX_CHARS=20000
MEMORY_MAX_CHARS=4000

# Tools
TOOL_TIMEOUT_SEC=30
TOOL_RESULT_MAX_CHARS=20000
MAX_TOOL_ITERATIONS=8
FILE_READ_MAX_CHARS=20000
FILE_WRITE_MAX_BYTES=1000000

# Git
GIT_TIMEOUT_SEC=60
GIT_DIFF_MAX_CHARS=20000

# venv, pip and running code
PIP_TIMEOUT_SEC=300
RUN_TIMEOUT_SEC=60
RUN_OUTPUT_MAX_CHARS=3000

# Limits for every process of a user-<id> account
RUN_MEMORY_MB=1024
RUN_CPU_SEC=600
RUN_FILE_MB=512
RUN_NPROC=128
